APP_NAME=SkillBridge
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=skillbridge
DB_USERNAME=skillbridge
DB_PASSWORD=skillbridge

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- SPA / Sanctum (Auth) ---
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# --- AI (Modules/Ai) ---
# Mode: "gemini" (cloud API), "offline" (100% local PHP engine, no API key needed), or "fallback" (cloud with local fallback).
SKILLBRIDGE_AI_MODE=gemini
# Never commit a real key. Backend only.
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT_SECONDS=60

# --- Matching (placeholder, must be calibrated; see docs/AI_PIPELINE.md) ---
SKILLBRIDGE_TOP_K=3
SKILLBRIDGE_SIM_FLOOR=0.50
SKILLBRIDGE_SIM_HIGH=0.80

# --- Upload (Rps) ---
SKILLBRIDGE_MAX_PDF_MB=10
SKILLBRIDGE_MAX_PAGES=60
SKILLBRIDGE_MIN_CHARS_PER_PAGE=50

# --- Rate limits (Auth) ---
SKILLBRIDGE_AUTH_PER_MINUTE=5
SKILLBRIDGE_UPLOAD_PER_MINUTE=10

# --- Recommendation priority (share of selected postings that counts as high demand) ---
SKILLBRIDGE_PRIORITY_HIGH_DEMAND_RATIO=0.5

# --- Job posting dataset seeding ---
# Set false to skip seeding the parts/*.json curated dataset on php artisan db:seed.
SEED_PARTS_JOBS=true
# Optional: absolute path to the folder containing all-*.json parts (default: ../parts).
# PARTS_DATA_PATH=
