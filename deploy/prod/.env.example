# Salin menjadi .env di server (chmod 600). Jangan commit .env.
# Nilai yang mengandung karakter $ perlu ditulis $$ (interpolasi compose).

# --- Image ---
# SHA commit atau tag image yang akan dijalankan (lihat tab Packages di GitHub).
IMAGE_TAG=latest
WEB_PORT=8080

# --- App ---
APP_NAME=SkillBridge
APP_ENV=production
APP_DEBUG=false
# Buat dengan: docker run --rm ghcr.io/ar-elfahmi/skillbridge-api:<tag> php artisan key:generate --show
APP_KEY=
APP_URL=https://skillbridge.example.com
APP_LOCALE=id
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database (dipakai juga oleh container postgres) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=skillbridge
DB_USERNAME=skillbridge
DB_PASSWORD=

# --- Redis (queue + cache) ---
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=database
FILESYSTEM_DISK=private

# --- SPA / Sanctum: satu domain, tanpa CORS ---
# Isi dengan host domain (tanpa skema), samakan dengan APP_URL.
FRONTEND_URL=https://skillbridge.example.com
SANCTUM_STATEFUL_DOMAINS=skillbridge.example.com
SESSION_DOMAIN=skillbridge.example.com
SESSION_SECURE_COOKIE=true

# --- AI ---
SKILLBRIDGE_AI_MODE=gemini
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT_SECONDS=60

# --- Matching / Upload / Rate limit ---
SKILLBRIDGE_TOP_K=3
SKILLBRIDGE_SIM_FLOOR=0.50
SKILLBRIDGE_SIM_HIGH=0.80
SKILLBRIDGE_MAX_PDF_MB=10
SKILLBRIDGE_MAX_PAGES=60
SKILLBRIDGE_MIN_CHARS_PER_PAGE=50
SKILLBRIDGE_AUTH_PER_MINUTE=5
SKILLBRIDGE_UPLOAD_PER_MINUTE=10
SKILLBRIDGE_PRIORITY_HIGH_DEMAND_RATIO=0.5
